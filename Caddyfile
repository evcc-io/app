# endpoint for basic auth app testing
:7080 {
	basic_auth {
		# user: admin
		# password: secret
		admin $2a$14$6raEvbSOkbyTizzW36qguOAJUfMf1Jc2uUEVxue33xkhDdygvRhCC
	}

	# evcc running locally
	reverse_proxy http://localhost:7070
}

# endpoints for external-auth app testing — :7090 plays an auth proxy that
# bounces unauthenticated requests to a fake identity provider on :7091
# (different origin, like a real SSO login page); logging in there sets a
# session cookie and redirects back
:7090 {
	@authed header_regexp Cookie ".*session=ok.*"
	handle @authed {
		reverse_proxy http://localhost:7070
	}
	handle {
		redir http://{http.request.host}:7091/login 302
	}
}

:7091 {
	handle /login {
		header Content-Type "text/html"
		respond "<html><body><a href='/callback' data-testid='fakeLogin'>Login</a></body></html>" 200
	}
	handle /callback {
		header +Set-Cookie "session=ok; Path=/"
		redir http://{http.request.host}:7090/ 302
	}
}

# endpoint for cookie-protected app testing — mirrors evcc's HttpOnly auth
# cookie so e2e can prove the webview's cookies are forwarded to downloads
:7081 {
	# /cookietest/file.csv returns 401 unless `testauth=letmein` is sent
	handle /cookietest/file.csv {
		@hasCookie header_regexp Cookie ".*testauth=letmein.*"
		handle @hasCookie {
			header Content-Type "text/csv"
			respond "cookie,present\ntestauth,letmein\n" 200
		}
		respond 401
	}

	# every other response sets the HttpOnly cookie so the webview picks it
	# up on its initial load and replays it on subsequent in-page fetches
	handle {
		header +Set-Cookie "testauth=letmein; Path=/; HttpOnly; SameSite=Strict"
		reverse_proxy http://localhost:7070
	}
}
