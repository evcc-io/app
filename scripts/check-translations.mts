/**
 * Validates the Weblate-managed locale files in ./i18n against en.json:
 * no empty strings (i18next would render them blank), no keys unknown to en,
 * no non-string leaves, and matching {{placeholders}}.
 */
import fs from "fs";
import path from "path";

const I18N = "./i18n";

function flatten(obj: object, prefix = ""): Record<string, unknown> {
  const out: Record<string, unknown> = {};
  for (const [k, v] of Object.entries(obj)) {
    const key = prefix ? `${prefix}.${k}` : k;
    if (v && typeof v === "object") Object.assign(out, flatten(v, key));
    else out[key] = v;
  }
  return out;
}

const load = (locale: string) =>
  flatten(
    JSON.parse(fs.readFileSync(path.join(I18N, `${locale}.json`), "utf8")),
  );

const placeholders = (s: string) =>
  [...new Set(s.match(/\{\{[^}]*\}\}/g) ?? [])].sort().join(", ");

const en = load("en");
const errors: string[] = [];

const locales = fs
  .readdirSync(I18N)
  .filter((f) => f.endsWith(".json"))
  .map((f) => path.basename(f, ".json"));

for (const locale of locales) {
  const strings = locale === "en" ? en : load(locale);
  for (const [key, value] of Object.entries(strings)) {
    const err = (msg: string) => errors.push(`${locale}.json ${key}: ${msg}`);
    if (typeof value !== "string") err(`not a string`);
    else if (value.trim() === "") err(`empty`);
    else if (!(key in en)) err(`not in en.json`);
    else if (placeholders(value) !== placeholders(en[key] as string))
      err(
        `placeholders "${placeholders(value)}", expected "${placeholders(en[key] as string)}"`,
      );
  }
}

// Widget catalog is generated by `npm run widget:strings`. Only app-owned keys
// (same key in en.json) are checked; evcc-sourced ones need ../evcc.
const catalog = JSON.parse(
  fs.readFileSync("./targets/widget/Localizable.xcstrings", "utf8"),
);
const lookup = (locale: string, key: string) =>
  [locale, locale.split("-")[0]]
    .filter((l) => locales.includes(l))
    .map((l) => (l === "en" ? en : load(l))[key])
    .find((v) => v !== undefined) ?? en[key];
for (const [key, entry] of Object.entries<{
  localizations: Record<string, { stringUnit: { value: string } }>;
}>(catalog.strings)) {
  if (!(key in en)) continue;
  for (const locale of locales) {
    if (entry.localizations[locale]?.stringUnit.value !== lookup(locale, key))
      errors.push(`Localizable.xcstrings ${key} (${locale}): stale`);
  }
}

if (errors.length) {
  console.error(errors.join("\n"));
  console.error(`\n${errors.length} translation errors.`);
  process.exit(1);
}
console.log(`Translations OK (${locales.length} locales).`);
