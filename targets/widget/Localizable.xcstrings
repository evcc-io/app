    "widget.setup.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to connect a server and pick a data type."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite da povežete server i odaberete tip podataka."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím připojíte server a zvolíte typ dat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at forbinde en server og vælge en datatype."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um Server zu verbinden und einen Datentyp zu wählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για να συνδέσετε ένα διακομιστή και να επιλέξετε τύπο δεδομένων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to connect a server and pick a data type."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsa ühendamaks serveriga ja andmetüübi valimiseks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta yhdistääksesi palvelimen ja valitaksesi tietotyypin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour se connecter à un serveur et choisir un type de données."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite za povezivanje poslužitelja i odabir vrste podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a szerver csatlakoztatásához és az adattípus kiválasztásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per collegare un server e scegliere un tipo di dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてサーバーを接続し、データの種類を選択します。"
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippt fir e Server ze verbannen an e Datentyp auszewielen."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palieskite, kad prisijungtumėte prie serverio ir pasirinktumėte duomenų tipą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties, lai izveidotu savienojumu ar serveri un izvēlētos datu tipu."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to connect a server and pick a data type."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te verbinden met een server en een datatype te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby połączyć serwer i wybrać typ danych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ligar a um servidor e selecionar um tipo de dados."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na pripojenie servera a vyberte dátový typ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite za povezavo strežnika in izbiro vrste podatkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att ansluta en server och välja en datatyp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேவையகத்தை இணைத்து தரவு வகையைத் தேர்ந்தெடுக்கத் தட்டவும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sunucu bağlamak ve veri türü seçmek için dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб підключити сервер і вибрати тип даних."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击以连接服务器并选择数据类型。"
          }
        }
      }
    },
